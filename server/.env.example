# --- Reasoning LLM (DeepSeek / Groq / OpenAI compatible) ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Or use Groq:
# GROQ_API_KEY=
# DEEPSEEK_BASE_URL=https://api.groq.com/openai/v1

# --- Speech-to-Speech (Optional NVIDIA TTS) ---
# Leave blank to use native browser speech (recommended)
NVIDIA_API_KEY=
NVIDIA_STS_BASE_URL=https://integrate.api.nvidia.com/v1

# --- Application Database (MongoDB) ---
MONGO_URI=mongodb://localhost:27017
MONGO_DB=interview

# --- Security ---
JWT_SECRET=your_secret_key_here
