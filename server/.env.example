# --- Server ---
PORT=8000
# Explicit allowed browser origin (comma-separated for multiple). No wildcard.
CORS_ORIGIN=http://localhost:5173

# --- Auth ---
# Required in production. If blank in dev, an ephemeral secret is generated
# (tokens then die on every restart) and a warning is logged.
JWT_SECRET=

# --- Database (MongoDB) ---
MONGO_URI=mongodb://localhost:27017
MONGO_DB=interview

# --- Reasoning LLM (DeepSeek, OpenAI-compatible endpoint) ---
# Leave blank to run the honest offline fallback (heuristic scores, canned feedback).
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# --- Speech (NVIDIA) ---
# Leave blank to run the offline synthetic-audio fallback (locally generated WAV).
NVIDIA_API_KEY=
NVIDIA_STS_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_TTS_MODEL=nvidia/nemo-tts
NVIDIA_TTS_VOICE=en-US-Standard-A
NVIDIA_STS_SAMPLE_RATE=16000

# --- RAG embeddings ---
# auto = load local transformers model (first use downloads it); keyword = offline term matching.
RAG_MODE=auto
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
